APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai

POSTGRES_V1_HOST=postgres_v1
POSTGRES_V1_PORT=5432
POSTGRES_V1_DB=stock_quant_v1
POSTGRES_V1_USER=stock
POSTGRES_V1_PASSWORD=stock

POSTGRES_V2_HOST=postgres_v2
POSTGRES_V2_PORT=5432
POSTGRES_V2_DB=stock_quant_v2
POSTGRES_V2_USER=stock
POSTGRES_V2_PASSWORD=stock

V2_SQLALCHEMY_URL=postgresql+psycopg://stock:stock@postgres_v2:5432/stock_quant_v2

POSTGRES_V2_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_quant_v2

TUSHARE_TOKEN=your_tushare_token_here

DEFAULT_MARKET_CODE=CN_A
DEFAULT_DAILY_BAR_PROVIDER=tushare
FALLBACK_DAILY_BAR_PROVIDER=sina

BOOTSTRAP_DAILY_BAR_START_DATE=2024-01-01
BOOTSTRAP_DAILY_BAR_END_DATE=2024-01-31
BOOTSTRAP_CALENDAR_START_DATE=2010-01-01
BOOTSTRAP_CALENDAR_END_DATE=2030-12-31

APP_ENV=dev
DEBUG=false

DAILY_BAR_DEBUG_MODE=true
DAILY_BAR_DEBUG_LIMIT_SYMBOLS=50